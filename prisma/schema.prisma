// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  SUPER_ADMIN
  ADMIN
  STUDENT
}

enum MaterialType {
  LECTURE
  NOTE
  ASSIGNMENT
  PAST_PAPER
  OTHER
}

enum SemesterStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  semesterId   String?
  semester     Semester? @relation(fields: [semesterId], references: [id])
  materials    Material[] @relation("UploadedBy")
  createdAt    DateTime @default(now())
}

model University {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  departments Department[]
}

model Department {
  id           String     @id @default(cuid())
  name         String
  universityId String
  university   University @relation(fields: [universityId], references: [id])
  programs     Program[]

  @@unique([universityId, name])
}

model Program {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  semesters    Semester[]

  @@unique([departmentId, name])
}

model Semester {
  id        String         @id @default(cuid())
  name      String
  year      Int
  status    SemesterStatus @default(ACTIVE)
  programId String
  program   Program        @relation(fields: [programId], references: [id])
  subjects  Subject[]
  users     User[]

  @@unique([programId, name])
}

model Subject {
  id         String     @id @default(cuid())
  name       String
  code       String
  semesterId String
  semester   Semester   @relation(fields: [semesterId], references: [id])
  materials  Material[]

  @@unique([semesterId, code])
}

model Material {
  id          String       @id @default(cuid())
  title       String
  type        MaterialType
  description String?
  fileKey     String
  fileSize    Int
  subjectId   String
  subject     Subject      @relation(fields: [subjectId], references: [id])
  uploadedBy  String
  uploader    User         @relation("UploadedBy", fields: [uploadedBy], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([subjectId, type])
}